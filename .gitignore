target/
.DS_Store
*.rs.bk
# Pikafish release archive downloaded by tools/fetch-engine.* (deleted
# after a successful fetch, but ignored so a failed run doesn't pollute
# git status).
*.7z
.github/workflows/
# Pikafish engine binaries + NNUE weights (downloaded, never committed).
# PIKAFISH_VERSION.toml is the pin and IS committed.
engine/*
!engine/PIKAFISH_VERSION.toml
# Board-recognition models (Xiangqi Arena, MIT) + the ONNX Runtime
# library (downloaded by tools/fetch-recognize.sh, never committed).
# RECOGNIZE_VERSION.toml is the pin and IS committed.
recognize/*
!recognize/RECOGNIZE_VERSION.toml
