target/
.DS_Store
*.rs.bk
# Pikafish release archive downloaded by tools/fetch-engine.* (deleted
# after a successful fetch, but ignored so a failed run doesn't pollute
# git status).
*.7z
.github/workflows/
# Pikafish engine binaries + NNUE weights (downloaded, never committed).
# PIKAFISH_VERSION.toml is the pin and IS committed.
engine/*
!engine/PIKAFISH_VERSION.toml
# Board-recognition models (Xiangqi Arena, MIT) + the ONNX Runtime
# library (downloaded by tools/fetch-recognize.sh, never committed).
# RECOGNIZE_VERSION.toml is the pin and IS committed.
recognize/*
!recognize/RECOGNIZE_VERSION.toml
# PWA spike (2026-11-26): Trunk output (rebuilt by `trunk build`)
# and the downloaded Pikafish-WASM engine files (51,6 MB — see
# crates/xq-iced/assets/engine-wasm/INTEGRATION.md §1 for the
# download URLs). The worker glue (`pikafish-worker.js`) and
# INTEGRATION.md ARE committed; only the three downloaded files
# below are ignored.
crates/xq-iced/dist/
crates/xq-iced/assets/engine-wasm/pikafish.js
crates/xq-iced/assets/engine-wasm/pikafish.wasm
crates/xq-iced/assets/engine-wasm/pikafish.data
